# Copy this file to .env before starting the Docker Compose stack.
POSTGRES_DB=aiops_db
POSTGRES_USER=aiops_app
POSTGRES_PASSWORD=replace-with-a-locally-generated-url-safe-password

# Local backend development can use a SQLite URL or PostgreSQL.
# Docker Compose constructs its own PostgreSQL connection URL from the variables above.
DATABASE_URL=sqlite:///./aiops_dev.db

# Generate a local value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-locally-generated-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api
ENVIRONMENT=development
